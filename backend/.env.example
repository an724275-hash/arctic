# Copy to .env for local development. For Docker copy the root .env.example.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://arctic:replace-me@127.0.0.1:5432/arctic
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
UPLOADS_DIR=storage/uploads
MAX_UPLOAD_MB=30
# Optional, OS Arial / DejaVu is detected automatically.
CERTIFICATE_FONT_PATH=
# Email stays in database outbox until configured and explicitly enabled.
ENABLE_EMAIL_DELIVERY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
